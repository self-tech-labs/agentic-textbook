{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.ogram.ch/contracts/v4/lesson-brief-v1.schema.json",
  "title": "learn.ogram LessonBriefV1",
  "description": "A local, topic-neutral brief prepared by the learner before a WebMCP session exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "topic",
    "desiredOutcome",
    "currentLevel",
    "availableMinutes",
    "preferredModes",
    "accessibilityNotes",
    "personalizeFromRecentTasks",
    "starterId",
    "blueprintId",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 4, "maxLength": 160 },
    "topic": { "type": "string", "maxLength": 300 },
    "desiredOutcome": { "type": "string", "maxLength": 600 },
    "currentLevel": {
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "availableMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 90
    },
    "preferredModes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": ["visual", "quantitative", "code", "scenario", "reading"]
      }
    },
    "accessibilityNotes": { "type": "string", "maxLength": 1000 },
    "personalizeFromRecentTasks": { "type": "boolean" },
    "starterId": {
      "type": ["string", "null"],
      "maxLength": 160
    },
    "blueprintId": {
      "enum": [
        "open_topic_v1",
        "codex_current_personalized_v1",
        "algebra_functions_v1",
        "code_debugging_v1",
        "transformer_technical_beginner"
      ]
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
