{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn.ogram.ch/contracts/v3/learning-event.schema.json",
  "title": "learn.ogram v3 canvas event",
  "description": "A sequenced, privacy-minimized event emitted by the agent-native learning canvas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "type", "actor", "at", "summary"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "agent.session.started",
        "context.claim.proposed",
        "context.claim.reviewed",
        "context.personalization.skipped",
        "lesson.draft.prepared",
        "lesson.draft.approved",
        "lesson.published",
        "canvas.region.focused",
        "canvas.region.patched",
        "canvas.widget.injected",
        "canvas.research.attached",
        "canvas.region.reverted",
        "learner.response.submitted"
      ]
    },
    "actor": {
      "type": "string",
      "enum": ["agent", "learner", "ogram"]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "payload": {
      "type": "object",
      "description": "Bounded IDs, revisions, digests, counts, provider labels, and sanitized summaries only. Credentials, raw connector content, full conversations, local paths, arbitrary prompts, and free-text learner answers are prohibited.",
      "additionalProperties": true
    }
  }
}
