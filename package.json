    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
